<Application x:Class="VoiceAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:va="http://voiceassistant.schemas.com/web/styles"
             xmlns:local="clr-namespace:VoiceAssistant">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="pack://application:,,,/Synergy.WPF.Common;component/Themes/Generic.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Synergy.WPF.Common;component/Styles/Synergy.WPF.Common.Shared.xaml"/>

                <ResourceDictionary Source="pack://application:,,,/VoiceAssistant.UI.Resources;component/Resources.Shared.xaml"/>

                <x:Static Member="va:StylesDictionary.Instance"/>
                <x:Static Member="va:StylesSharedDictionary.Instance"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
