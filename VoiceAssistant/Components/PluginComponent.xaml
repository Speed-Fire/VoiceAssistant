<UserControl x:Class="VoiceAssistant.Components.PluginComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style x:Key="Styles.Local.TextBlock.StrTitle" TargetType="TextBlock"
               BasedOn="{StaticResource Styles.TextBlock}">

            <Setter Property="FontWeight" Value="Bold"/>

        </Style>
        
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource Styles.ScrollViewer}">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Grid.ColumnSpan="3"
                  Margin="0 0 0 10">

                <Image DockPanel.Dock="Left"
                       MaxHeight="48"
                       Source="{Binding Image}"/>

                <TextBlock FontSize="18"
                           Margin="10 0 0 0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Text="{Binding Name}"/>

            </DockPanel>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource Styles.Local.TextBlock.StrTitle}"
                       Margin="0 0 5 0"
                       Text="Version:"/>

            <TextBlock Grid.Row="1" Grid.Column="2"
                       Text="{Binding Version}"/>

            <Rectangle Grid.Row="2" Grid.ColumnSpan="3"
                       Style="{StaticResource Styles.Delimeter.Horizontal}"
                       Margin="0 15 0 15"/>

            <TextBlock Grid.Row="3" Style="{StaticResource Styles.Local.TextBlock.StrTitle}"
                       Text="Description:"
                       Margin="0 0 0 10"/>

            <TextBlock Grid.Row="4" Grid.ColumnSpan="3"
                       TextWrapping="Wrap"
                       Text="{Binding Description}"/>

            <Rectangle Grid.Row="5" Grid.ColumnSpan="3"
                       Style="{StaticResource Styles.Delimeter.Horizontal}"
                       Margin="0 15 0 15"/>

            <TextBlock Grid.Row="6" Style="{StaticResource Styles.Local.TextBlock.StrTitle}"
                       Text="Authors:"
                       Margin="0 0 0 10"/>

            <TextBlock Grid.Row="6" Grid.Column="2"
                       TextWrapping="Wrap"
                       Text="{Binding Authors}"/>

            <TextBlock Grid.Row="7" Style="{StaticResource Styles.Local.TextBlock.StrTitle}"
                       Text="Project URL-address:"
                       Margin="0 0 0 10"/>

            <TextBlock Grid.Row="7" Grid.Column="2"
                       TextWrapping="Wrap">
            
                <Hyperlink NavigateUri="{Binding UrlAddress}"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="{Binding UrlAddress, Mode=OneWay}"/>
                </Hyperlink>

            </TextBlock>

        </Grid>

    </ScrollViewer>

</UserControl>
