<UserControl x:Class="VoiceAssistant.Components.WindowUpperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Components"
             
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
             
             MouseMove="UserControl_MouseMove"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Path x:Key="Paths.Local.Close"
              Stroke="{StaticResource Brushes.Senary}"
              Data="M 0,0 14,14 M 14,0 0,14"/>

        <Path x:Key="Paths.Local.Hide"
              Stroke="{StaticResource Brushes.Senary}"
              Data="M 0,1 14,1"/>

        <Path x:Key="Paths.Local.Expand"
              Stroke="{StaticResource Brushes.Senary}"
              Data="M 2,2 0,2 0,14 12,14 12,12 14,12 14,0 2,0 2,2 12,2 12,12"/>

        <DrawingBrush x:Key="Brush.Local.Component">

            <DrawingBrush.Drawing>

                <GeometryDrawing Brush="{StaticResource Brushes.Secondary}">

                    <GeometryDrawing.Geometry>
                        <Geometry>
M 0 0 H -50 Q -50 5 -48 10 L -42 26 Q -40 30 -30 30 H 50 V 0 z
                        </Geometry>
                    </GeometryDrawing.Geometry>
                    
                </GeometryDrawing>
                
            </DrawingBrush.Drawing>
            
        </DrawingBrush>

        <Style x:Key="Styles.Local.Button.Close" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Synergy.Styles.NormalButton.Base}">

            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="#D71118"/>
            <Setter Property="Padding" Value="15 5 15 5"/>
            <Setter Property="Content" Value="{StaticResource Paths.Local.Close}"/>
            <Setter Property="MinHeight" Value="30"/>

        </Style>

        <Style x:Key="Styles.Local.Button.Window" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Synergy.Styles.NormalButton.Base}">
            <Setter Property="Background" Value="{StaticResource Brushes.Secondary}"/>
            <Setter Property="Padding" Value="15 5 15 5"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="MinHeight" Value="30"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="{StaticResource Brushes.Quinary}"/>
                </Trigger>
            </Style.Triggers>
            
        </Style>

        <Style x:Key="Styles.Local.Button.Hide" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Styles.Local.Button.Window}">
            <Setter Property="Content" Value="{StaticResource Paths.Local.Hide}"/>
        </Style>

        <Style x:Key="Styles.Local.Button.Expand" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Styles.Local.Button.Window}">
            <Setter Property="Content" Value="{StaticResource Paths.Local.Expand}"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Local.Component}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleTB"
                   Grid.Column="1"
                   FontSize="18"
                   VerticalAlignment="Center"/>

        <controls:NormalButton Grid.Column="2"
                               Style="{StaticResource Styles.Local.Button.Hide}"
                               Click="HideButton_Click"/>

        <controls:NormalButton Grid.Column="3"
                               Style="{StaticResource Styles.Local.Button.Expand}"
                               Click="ExpandButton_Click"/>

        <controls:NormalButton Grid.Column="4"
                               Style="{StaticResource Styles.Local.Button.Close}"
                               Click="CloseButton_Click"/>

    </Grid>
    
</UserControl>
