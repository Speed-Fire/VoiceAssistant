        <Style x:Key="Styles.Local.ToggleButton" TargetType="ToggleButton">

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border Background="Transparent">

                            <Viewbox MaxHeight="44" MaxWidth="44">

                                <Path Style="{StaticResource Styles.Local.Path.Ear}"
                                      Data="{StaticResource Strings.Local.PathData}"/>

                            </Viewbox>

                        </Border>
                        
