<UserControl x:Class="VoiceAssistant.Components.AssistantActionComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Components"
             xmlns:viewws="clr-namespace:VoiceAssistant.Views"
             
             xmlns:convs="clr-namespace:Synergy.WPF.Common.Converters;assembly=Synergy.WPF.Common"
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <convs:IsNullConverter x:Key="isnullconv"/>

        <Style x:Key="Styles.Local.Border.Outer" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>

            <Style.Triggers>

                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                            <ColorAnimation 
                                    From="Transparent"
                                    To="#A448FF"
                                    Duration="0:0:0.5"
                                    DecelerationRatio="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                            <ColorAnimation 
                                    From="#A448FF"
                                    To="Transparent"
                                    Duration="0:0:0.5"
                                    DecelerationRatio="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="Styles.Local.Border.InnerAttention" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding NeedsConfirmation}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                
            </Style.Triggers>
        </Style>

        <Style x:Key="Styles.Local.Border.InnerNormal" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brushes.Secondary}"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding NeedsConfirmation}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="Styles.Local.Border.Inner" TargetType="Border">

            <Setter Property="Background" Value="{StaticResource Brushes.Secondary}"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="5"/>

        </Style>

        <Style x:Key="Styles.Local.Grid.Description" TargetType="Grid">
            <Style.Triggers>

                <DataTrigger Binding="{Binding Description, Converter={StaticResource isnullconv}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="Styles.Local.Image.Attention" TargetType="Image">
            <Setter Property="MaxHeight" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0 0 15 0"/>
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsConfirmation}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>

        </Style>

        <Style x:Key="Styles.Local.Border.Enability" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brushes.Secondary}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Panel.ZIndex" Value="10"/>

        </Style>
        
        <Style x:Key="Styles.Local.TextBlock.Righted" TargetType="TextBlock"
               BasedOn="{StaticResource Styles.TextBlock}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5 0 0 0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="Styles.Local.Button.Base" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Synergy.Styles.NormalButton.Base}">

            <Setter Property="Background" Value="{StaticResource Brushes.Secondary}"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Panel.ZIndex" Value="11"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="{StaticResource Brushes.Quinary}"/>
                </Trigger>
            </Style.Triggers>
            
        </Style>

        <Style x:Key="Styles.Local.Button.Update" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Styles.Local.Button.Base}">

            <Setter Property="Content">
                <Setter.Value>

                    <Image MaxHeight="28"
                           Source="{StaticResource Bitmaps.Edit64}"/>

                </Setter.Value>
            </Setter>
            
        </Style>

        <Style x:Key="Styles.Local.Button.Delete" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Styles.Local.Button.Base}">

            <Setter Property="Content">
                <Setter.Value>

                    <Image MaxHeight="28"
                           Source="{StaticResource Bitmaps.Delete64}"/>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource Styles.Local.Border.Outer}">

        <Grid>

            <Border Style="{StaticResource Styles.Local.Border.InnerAttention}">
                <Border.BorderBrush>
                    <VisualBrush>
                        <VisualBrush.Visual>

                            <Grid>

                                <Rectangle StrokeDashArray="4 4" Stroke="OrangeRed" StrokeThickness="3"
                                   RadiusX="15" RadiusY="15"
                  Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualWidth}"
                  Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualHeight}"/>

                                <Rectangle StrokeDashArray="4 4" Stroke="LightGray" StrokeThickness="3"
                                   RadiusX="15" RadiusY="15" StrokeDashOffset="4"
                  Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualWidth}"
                  Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualHeight}"/>

                            </Grid>

                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.BorderBrush>
            </Border>

            <Border Style="{StaticResource Styles.Local.Border.InnerNormal}"/>

            <Border Style="{StaticResource Styles.Local.Border.Inner}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="8" x:Name="EnabilityBorder"
                            Style="{StaticResource Styles.Local.Border.Enability}"/>

                    <Grid Grid.Row="0"
                          Margin="10 10 0 0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="20"
                                   VerticalAlignment="Center"
                                   Text="{Binding Name}"/>

                        <Image Grid.Column="1"
                               Style="{StaticResource Styles.Local.Image.Attention}"
                               Source="{StaticResource Bitmaps.Attention64}"/>

                    </Grid>

                    <Rectangle Style="{StaticResource Styles.Delimeter.Horizontal}"
                               Margin="0 15 0 15"
                               Grid.Row="1"/>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{StaticResource Bitmaps.Voice64}"/>

                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Styles.Local.TextBlock.Righted}"
                                   Text="{Binding Command}"/>

                    </Grid>

                    <Rectangle Style="{StaticResource Styles.Delimeter.Horizontal}"
                               Margin="0 15 0 15"
                               Grid.Row="3"/>

                    <Grid Style="{StaticResource Styles.Local.Grid.Description}" 
                          Margin="0 0 0 15"
                          Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Image Source="{StaticResource Bitmaps.Description64}"/>

                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Styles.Local.TextBlock.Righted}"
                                   Text="{Binding Description}"/>

                        <Rectangle Style="{StaticResource Styles.Delimeter.Horizontal}"
                                   Margin="0 15 0 0"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"/>

                    </Grid>

                    <Grid Grid.Row="5"
                          Margin="0 0 0 15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{StaticResource Bitmaps.Script64}"/>

                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Styles.Local.TextBlock.Righted}"
                                   Text="{Binding AssistantScript.Name}"/>

                    </Grid>

                    <Rectangle Style="{StaticResource Styles.Delimeter.Horizontal}"
                               Margin="0 0 0 7"
                               Grid.Row="6"/>

                    <DockPanel Grid.Row="7"
                               Panel.ZIndex="11"
                               Margin="0 0 10 7">

                        <controls:NormalButton
                            x:Name="DeleteButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Styles.Local.Button.Delete}"
                            CommandParameter="{Binding}"/>

                        <controls:NormalButton
                            x:Name="EditButton"
                            DockPanel.Dock="Right"
                            Margin="0 0 15 0"
                            Style="{StaticResource Styles.Local.Button.Update}"
                            CommandParameter="{Binding}"/>

                        <controls:SliderButton Name="EnableButton"
                                               Style="{StaticResource Styles.SliderButton.Round}"
                                               HorizontalAlignment="Left"
                                               DockPanel.Dock="Left"
                                               IsChecked="{Binding IsEnabled}"
                                               CommandParameter="{Binding}"/>

                    </DockPanel>
                    
                </Grid>
            
            </Border>

        </Grid>

    </Border>
    
</UserControl>
