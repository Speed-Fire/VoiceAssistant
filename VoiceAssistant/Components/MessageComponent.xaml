<UserControl x:Class="VoiceAssistant.Components.MessageComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Components.MessageBox"
                   
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
             xmlns:attached="clr-namespace:Synergy.WPF.Common.AttachedProperties;assembly=Synergy.WPF.Common"
             
             attached:AnimateFadeInProperty.Value="{Binding IsVisible}"
             
             x:Name="main_element"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <local:MessageBoxImageConverter x:Key="imconv"/>
        <local:ButtonDataTemplateSelector x:Key="buttonselector"/>

        <Style x:Key="Styles.Local.NormalButton" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Styles.NormalButton}">
            <Setter Property="Command" Value="{Binding ElementName=main_element,
                Path=DataContext.SetResultCommand}"/>
        </Style>
        
        <DataTemplate x:Key="Templates.Local.Buttons.OK">
            <Grid>

                <controls:NormalButton
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.OK}"
                    Content="{DynamicResource Strings.Buttons.OK}"
                    HorizontalAlignment="Right"/>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.Buttons.OKCancel">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:NormalButton
                    Grid.Column="1"
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.OK}"
                    Content="{DynamicResource Strings.Buttons.OK}"/>

                <controls:NormalButton
                    Grid.Column="3"
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.Cancel}"
                    Content="{DynamicResource Strings.Buttons.Cancel}"/>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.Buttons.YesNoCancel">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:NormalButton
                    Grid.Column="1"
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.Yes}"
                    Content="{DynamicResource Strings.Buttons.Yes}"/>

                <controls:NormalButton
                    Grid.Column="3"
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.No}"
                    Content="{DynamicResource Strings.Buttons.No}"/>
                
                <controls:NormalButton
                    Grid.Column="5"
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.Cancel}"
                    Content="{DynamicResource Strings.Buttons.Cancel}"/>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.Buttons.YesNo">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:NormalButton
                    Grid.Column="1"
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.Yes}"
                    Content="{DynamicResource Strings.Buttons.Yes}"/>

                <controls:NormalButton
                    Grid.Column="3"
                    Style="{StaticResource Styles.Local.NormalButton}"
                    CommandParameter="{x:Static MessageBoxResult.No}"
                    Content="{DynamicResource Strings.Buttons.No}"/>

            </Grid>
        </DataTemplate>

    </UserControl.Resources>
    
    <Grid Background="#C0000000">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="1" Grid.Column="1"
                Style="{StaticResource Styles.Border.Background}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       MaxHeight="38"
                       VerticalAlignment="Top"
                       Source="{Binding Image, Converter={StaticResource imconv}}"/>

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Styles.TextBlock}"
                           TextWrapping="Wrap"
                           Margin="0 8 0 0"
                           Text="{Binding Message}"/>

                <Rectangle Grid.Row="1" Grid.ColumnSpan="3"
                           Style="{StaticResource Styles.Delimeter.Horizontal}"
                           Margin="0 15 0 15"/>

                <ContentControl Grid.Row="2" Grid.ColumnSpan="3"
                                Content="{Binding Button}"
                                ContentTemplateSelector="{StaticResource buttonselector}"/>

            </Grid>

        </Border>
        
    </Grid>
    
</UserControl>
