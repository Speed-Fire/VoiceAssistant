<UserControl x:Class="VoiceAssistant.Components.UrgentNotificatorComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Components"
             
             xmlns:attached="clr-namespace:Synergy.WPF.Common.AttachedProperties;assembly=Synergy.WPF.Common"
             xmlns:convs="clr-namespace:Synergy.WPF.Common.Converters;assembly=Synergy.WPF.Common"
             
             attached:AnimateSlideInFromRightProperty.Value="{Binding IsNotificationShown, Mode=TwoWay}"
             Visibility="Hidden"
             
             VerticalAlignment="Top"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <convs:NotNullConverter x:Key="nnullconv"/>

        <ControlTemplate x:Key="Templates.Local.Grid" TargetType="Control">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="grid_image" MaxHeight="45"/>

                <TextBlock x:Name="grid_textBlock"
                           Grid.Column="1"
                           FontSize="25"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

            <ControlTemplate.Triggers>

                <DataTrigger Binding="{Binding Image}" Value="Error">

                    <Setter TargetName="grid_image" Property="Source"
                            Value="{StaticResource Bitmaps.Error64}"/>

                    <Setter TargetName="grid_textBlock" Property="Text"
                            Value="{DynamicResource Strings.Notifications.Error}"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding Image}" Value="Warning">

                    <Setter TargetName="grid_image" Property="Source"
                            Value="{StaticResource Bitmaps.Warning64}"/>

                    <Setter TargetName="grid_textBlock" Property="Text"
                            Value="{DynamicResource Strings.Notifications.Warning}"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding Image}" Value="Information">

                    <Setter TargetName="grid_image" Property="Source"
                            Value="{StaticResource Bitmaps.Info64}"/>

                    <Setter TargetName="grid_textBlock" Property="Text"
                            Value="{DynamicResource Strings.Notifications.Information}"/>

                </DataTrigger>

            </ControlTemplate.Triggers>
            
        </ControlTemplate>

        <Style x:Key="Styles.Local.Border.Urgent" TargetType="Border"
               BasedOn="{StaticResource Styles.Border.Background}">

            <Setter Property="BorderBrush" Value="Goldenrod"/>
            <Setter Property="BorderThickness" Value="3 3 0 3"/>
            <Setter Property="Padding" Value="15 15 0 15"/>
            <Setter Property="CornerRadius" Value="20 0 0 20"/>

        </Style>

        <Style x:Key="Styles.Local.Expander" TargetType="Expander">

            <Style.Triggers>

                <DataTrigger Binding="{Binding AdditionalInfo, Converter={StaticResource nnullconv}}"
                             Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>
    
    <Border
        x:Name="UrgentBorder"
        Style="{StaticResource Styles.Local.Border.Urgent}">

        <ScrollViewer
            Style="{StaticResource Styles.ScrollViewer}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <Control Template="{StaticResource Templates.Local.Grid}"/>

                <Rectangle Grid.Row="1"
                           Style="{StaticResource Styles.Delimeter.Horizontal}"
                           Margin="0 15 0 15"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"/>

                <Expander Grid.Row="3"
                          Style="{StaticResource Styles.Local.Expander}"
                          Header="{DynamicResource Strings.Notifications.AdditionalInfo}"
                          Margin="0 30 0 0">
                    <TextBlock Text="{Binding AdditionalInfo}"/>
                </Expander>

            </Grid>
            
        </ScrollViewer>
        
    </Border>
    
</UserControl>
