  <ItemGroup>
	  <Compile Include="AssemblyInfo.cs">
		  <Link>Properties\AssemblyInfo.cs</Link>
	  </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
