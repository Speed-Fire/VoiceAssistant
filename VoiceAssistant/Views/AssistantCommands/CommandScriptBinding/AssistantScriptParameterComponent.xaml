<UserControl x:Class="VoiceAssistant.Views.AssistantCommands.AssistantScriptParameterComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Views.AssistantCommands"
             
             xmlns:convs="clr-namespace:Synergy.WPF.Common.Converters;assembly=Synergy.WPF.Common"
             xmlns:attached="clr-namespace:Synergy.WPF.Common.AttachedProperties;assembly=Synergy.WPF.Common"
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <sys:Int32 x:Key="maxVisibleLength">20</sys:Int32>

        <local:ParenthesisConverter x:Key="parconv"/>
        <local:StringToBoolConverter x:Key="s2vconv"/>

        <convs:ValueConverterGroup x:Key="bindedparamnameconv">
            <local:ParenthesisRemoverConverter/>
            <convs:LongStroryShortConverter/>
        </convs:ValueConverterGroup>
        
        <DataTemplate x:Key="Templates.Local.TimePicker">

        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.BoolPicker">
            <CheckBox Style="{StaticResource Styles.CheckBox}"
                      Margin="0 2 0 2"
                      FontSize="15"
                      Content="{Binding Title}"
                      IsChecked="{Binding Value, Converter={StaticResource s2vconv}}"
                      AllowDrop="True"
                      Drop="OnDrop"/>
        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.IntegerPicker">

            <controls:AdvancedTextBox
                Grid.Row="1"
                Style="{StaticResource Styles.AdvancedTextBox}"
                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                attached:RegexAttachedProperty.Value="^[0-9-]*$"
                Drop="OnDrop"
                PreviewDragOver="AdvancedTextBox_PreviewDragOver"/>

        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.DoublePicker">

            <controls:AdvancedTextBox
                Grid.Row="1"
                Style="{StaticResource Styles.AdvancedTextBox}"
                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                attached:RegexAttachedProperty.Value="^[0-9-.]*$"
                Drop="OnDrop"
                PreviewDragOver="AdvancedTextBox_PreviewDragOver"/>

        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.DatePicker">

            <DatePicker Grid.Row="1"
                        Text="{Binding Value}"/>

        </DataTemplate>

        <DataTemplate x:Key="Templates.Local.StringPicker">

            <controls:AdvancedTextBox
                Grid.Row="1"
                Style="{StaticResource Styles.AdvancedTextBox}"
                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                attached:RegexAttachedProperty.Value="^(?!.*[\{\}]).*$"
                Drop="OnDrop"
                PreviewDragOver="AdvancedTextBox_PreviewDragOver"/>

        </DataTemplate>

        <local:AssistantScriptParameterTemplateSelector x:Key="selector"/>

        <Style x:Key="Styles.Local.ContentControl" TargetType="ContentControl">

            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding Value, Converter={StaticResource parconv}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                
            </Style.Triggers>
        </Style>

        <Style x:Key="Styles.Local.Border" TargetType="Border"
               BasedOn="{StaticResource Styles.Border.Background}">

            <Setter Property="Padding" Value="8 1.5 8 1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding Value, Converter={StaticResource parconv}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="Styles.Local.Button" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border>

                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

            <Setter Property="Content">
                <Setter.Value>

                    <Image Source="{StaticResource Bitmaps.Error64}"
                           MaxHeight="16"/>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="header_tb"
                   Text="{Binding Title}"
                   FontSize="15"
                   Margin="0 0 0 3"/>

        <Grid Grid.Row="1">

            <ContentControl Style="{StaticResource Styles.Local.ContentControl}"
                            Content="{Binding}" AllowDrop="True"
                            ContentTemplateSelector="{StaticResource selector}"/>

            <Border Grid.Row="1"
                    Style="{StaticResource Styles.Local.Border}"
                    BorderBrush="{StaticResource Brushes.Terdenary}"
                    Background="#303030">

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="15"
                               Text="{Binding Value, Converter={StaticResource bindedparamnameconv},
                                        ConverterParameter={StaticResource maxVisibleLength}}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource Styles.Local.Button}"
                            Command="{Binding ClearCommand}"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>
    
</UserControl>
