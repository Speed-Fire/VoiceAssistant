<UserControl x:Class="VoiceAssistant.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Views.Settings"
             
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
             xmlns:locattach="clr-namespace:VoiceAssistant.UI.Common.AttachedProperties;assembly=VoiceAssistant.UI.Common"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>

        <Style x:Key="Styles.Local.ListBoxItem.Settings" TargetType="ListBoxItem">

            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="border"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>

                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>

                                </MultiTrigger.Conditions>

                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>

                                        <LinearGradientBrush StartPoint="0, 0.5" EndPoint="1, 0.5">

                                            <GradientStop Color="{DynamicResource Colors.Secondary}"
                                                          Offset="0"/>
                                            
                                            <GradientStop Color="{DynamicResource Colors.Quinary}"
                                                          Offset="0.02"/>

                                            <GradientStop Color="{DynamicResource Colors.Quinary}"
                                                          Offset="0.8"/>

                                            <GradientStop Color="{DynamicResource Colors.Secondary}"
                                                          Offset="1"/>

                                        </LinearGradientBrush>
                                        
                                    </Setter.Value>
                                </Setter>

                            </MultiTrigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>

                                        <LinearGradientBrush StartPoint="0, 0.5" EndPoint="1, 0.5">

                                            <GradientStop Color="{DynamicResource Colors.Secondary}"
                                                          Offset="0"/>

                                            <GradientStop Color="{DynamicResource Colors.Denary}"
                                                          Offset="0.02"/>

                                            <GradientStop Color="{DynamicResource Colors.Denary}"
                                                          Offset="0.8"/>

                                            <GradientStop Color="{DynamicResource Colors.Secondary}"
                                                          Offset="1"/>

                                        </LinearGradientBrush>
                                        
                                    </Setter.Value>
                                </Setter>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="Styles.Local.ListBox" TargetType="ListBox"
               BasedOn="{StaticResource Styles.ListBox.Transparent}">

            <Setter Property="ItemContainerStyle" Value="{StaticResource Styles.Local.ListBoxItem.Settings}"/>

        </Style>

    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.1*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Grid.Column="1"
                Style="{StaticResource Styles.Border.Background}">

            <Grid x:Name="InnerGrid">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="SettingsLB"
                         Style="{StaticResource Styles.Local.ListBox}"
                         SelectionMode="Single"
                         SelectionChanged="ListBox_SelectionChanged">

                    <TextBlock Style="{StaticResource Styles.TextBlock}"
                               FontSize="20"
                               Text="Appearance"
                               locattach:CommandAttachedProperty.Value="{Binding OpenAppearanceSettingsCommand}"/>

                    <TextBlock Style="{StaticResource Styles.TextBlock}"
                               FontSize="20"
                               Text="Voice recognition"
                               locattach:CommandAttachedProperty.Value="{Binding OpenVoiceRecognitionSettingsCommand}"/>

                </ListBox>

                <Rectangle Grid.Column="1"
                           Style="{StaticResource Styles.Delimeter.Vertical}"
                           Margin="10 0 10 0"/>

            </Grid>
            
        </Border>
        
    </Grid>
    
</UserControl>
