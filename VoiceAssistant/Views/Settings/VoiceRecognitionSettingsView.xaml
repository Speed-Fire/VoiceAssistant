<UserControl x:Class="VoiceAssistant.Views.Settings.VoiceRecognitionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Views.Settings"
             
             xmlns:convs="clr-namespace:Synergy.WPF.Common.Converters;assembly=Synergy.WPF.Common"
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <convs:InvertBoolConverter x:Key="invconv"/>

        <Style TargetType="TextBlock"
               BasedOn="{StaticResource Styles.TextBlock.Settings}"/>

        <Style TargetType="ComboBox" BasedOn="{StaticResource Styles.ComboBox}">

            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="300"/>

        </Style>

        <Style TargetType="controls:AdvancedTextBox" BasedOn="{StaticResource Styles.AdvancedTextBox}">
            
            <Setter Property="Width" Value="300"/>

        </Style>

        <Style TargetType="GroupBox" BasedOn="{StaticResource Styles.GroupBox}">

            <Setter Property="HorizontalAlignment" Value="Left"/>

        </Style>
        
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource Styles.ScrollViewer}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Strings.Settings.VoiceRecognition.S2T.Converter.Colon}"/>

            <ComboBox
                Grid.Row="1"
                ItemsSource="{Binding SpeechToTextSettings.AvailableConverters}"
                SelectedItem="{Binding SpeechToTextSettings.SelectedConverter}"/>

            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Strings.Settings.VoiceRecognition.Gemini.ServiceApiKey.Colon}"/>

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:AdvancedTextBox
                    Text="{Binding GeminiSettings.ServiceApiKey}"/>

                <controls:NormalButton
                    Grid.Column="2"
                    Style="{StaticResource Styles.NormalButton}"
                    Content="{DynamicResource Strings.Buttons.Apply}"
                    Command="{Binding GeminiSettings.ApplyCommand}"/>

            </Grid>

        </Grid>
        
    </ScrollViewer>
    
</UserControl>
