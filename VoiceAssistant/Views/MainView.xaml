<UserControl x:Class="VoiceAssistant.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Views"
             
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common" xmlns:components="clr-namespace:Synergy.WPF.Navigation.Components;assembly=Synergy.WPF.Navigation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="../Styles/NavPanelStyle.xaml"/>
                <ResourceDictionary Source="../Styles/NavPanelIcons.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <controls:Sidebar
            x:Name="NavBar"
            TitleIcon="{StaticResource Icons.Main}"
            TitleIconColor="{StaticResource Brushes.Triple}"
            Style="{StaticResource Styles.Sidebar}">

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenCommandsTabCommand}"
                Icon="{StaticResource Icons.Commands}"
                Content="Commands"/>

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenScriptEditorTabCommand}"
                Icon="{StaticResource Icons.Scripts}"
                Content="Script editor"/>

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenPluginsTabCommand}"
                Icon="{StaticResource Icons.Plugin}"
                Content="Plugins"/>

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenSettingsTabCommand}"
                Icon="{StaticResource Icons.Settings}"
                Content="Settings"/>

        </controls:Sidebar>

        
        
    </Grid>
    
</UserControl>
