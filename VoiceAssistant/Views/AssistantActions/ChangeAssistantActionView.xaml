<UserControl x:Class="VoiceAssistant.Views.AssistantActions.ChangeAssistantActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Views"
             
             xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style TargetType="TextBlock"
               BasedOn="{StaticResource Styles.TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Image">
            <Setter Property="MaxHeight" Value="32"/>
        </Style>

        <Style TargetType="controls:AdvancedTextBox"
               BasedOn="{StaticResource Synergy.Styles.AdvancedTextBox}">
            <Setter Property="Width" Value="400"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="Styles.Local.Button.Change" TargetType="controls:NormalButton"
               BasedOn="{StaticResource Styles.NormalButton}">

            <Setter Property="Content" Value="{DynamicResource Strings.Buttons.Create}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpdatingMode}" Value="True">
                    <Setter Property="Content" Value="{DynamicResource Strings.Buttons.Change}"/>
                </DataTrigger>
            </Style.Triggers>
            
        </Style>
        
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.1*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <controls:NormalButton Style="{StaticResource Styles.Button.Return}"
                Grid.Row="1"
                VerticalAlignment="Top"
                Command="{Binding CancelCommand}"/>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource Styles.Border.Background}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Name -->
                
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Margin="0 0 0 3"
                           Text="{DynamicResource Strings.AsssistantAction.Change.Name.Colon}"/>

                <controls:AdvancedTextBox Grid.Row="1" Grid.Column="2"
                                          Placeholder="Name"
                                          Text="{Binding AssistantAction.Name}"/>

                <!-- Command -->

                <Image Grid.Row="3" Grid.Column="0"
                       Source="{StaticResource Bitmaps.Voice64}"/>

                <TextBlock Grid.Row="3" Grid.Column="2"
                           Text="{DynamicResource Strings.AsssistantAction.Change.Command.Colon}"/>

                <controls:AdvancedTextBox Grid.Row="4" Grid.Column="2"
                                          Text="{Binding AssistantAction.Command}"/>

                <!-- Description -->

                <Image Grid.Row="6" Grid.Column="0"
                       Source="{StaticResource Bitmaps.Description64}"/>

                <TextBlock Grid.Row="6" Grid.Column="2"
                           Text="{DynamicResource Strings.AsssistantAction.Change.Description.Colon}"/>

                <controls:AdvancedTextBox Grid.Row="7" Grid.Column="2"
                                          Text="{Binding AssistantAction.Description}"/>

                <!-- Script -->

                <Image Grid.Row="9" Grid.Column="0"
                       Source="{StaticResource Bitmaps.Script64}"/>

                <TextBlock Grid.Row="9" Grid.Column="2"
                           Text="{DynamicResource Strings.AsssistantAction.Change.Script.Colon}"/>

                <Grid Grid.Row="10" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:AdvancedTextBox Grid.Column="0"/>

                    <controls:NormalButton
                        Grid.Column="1"
                        Content="Select"/>

                </Grid>
                
                <!-- Buttons -->

                <Rectangle Grid.Row="11" Grid.ColumnSpan="3"
                           Margin="0 15 0 15"
                           Style="{StaticResource Styles.Delimeter.Horizontal}"/>

                <controls:NormalButton
                    Grid.Row="12" Grid.Column="2"
                    Style="{StaticResource Styles.Local.Button.Change}"
                    HorizontalAlignment="Right"
                    Margin="0 0 10 0"
                    Command="{Binding ChangeCommand}"/>

            </Grid>
            
        </Border>
        
    </Grid>
    
</UserControl>
