<UserControl x:Class="VoiceAssistant.Views.Plugins.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoiceAssistant.Views.Plugins"
             
             xmlns:convs="clr-namespace:Synergy.WPF.Common.Converters;assembly=Synergy.WPF.Common"
             xmlns:comps="clr-namespace:VoiceAssistant.Components"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <convs:ValueConverterGroup x:Key="null2vconv">
            <convs:NotNullConverter/>
            <convs:Bool2VisibilityConverter/>
        </convs:ValueConverterGroup>

        <Style x:Key="Styles.Local.ListBoxItem.Plugin" TargetType="ListBoxItem">

            <Setter Property="Padding" Value="2 5 2 5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="border"
                                Padding="{TemplateBinding Padding}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image MaxHeight="32"
                                       Source="{Binding Image}"/>

                                <TextBlock Grid.Column="1"
                                           FontSize="25" FontWeight="Bold"
                                           Margin="10 0 0 0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>

                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>

                                </MultiTrigger.Conditions>

                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource Brushes.Quinary}"/>

                            </MultiTrigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource Brushes.Denary}"/>

                            </Trigger>
                            
                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
        </Style>

        <Style x:Key="Styles.Local.ListBox" TargetType="ListBox"
               BasedOn="{StaticResource Styles.ListBox.Transparent}">

            <Setter Property="ItemContainerStyle" Value="{StaticResource Styles.Local.ListBoxItem.Plugin}"/>

        </Style>
        
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.1*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Grid.Column="1"
            Style="{StaticResource Styles.Border.Background}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.3*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="PluginsListBox"
                         Style="{StaticResource Styles.Local.ListBox}"
                         ItemsSource="{Binding Plugins}"/>

                <Rectangle Grid.Column="1"
                           Style="{StaticResource Styles.Delimeter.Vertical}"
                           Margin="15 0 15 0"/>

                <comps:PluginComponent Grid.Column="2"
                                       Visibility="{Binding ElementName=PluginsListBox,
                                           Path=SelectedItem,
                                           Converter={StaticResource null2vconv}}"
                                       DataContext="{Binding ElementName=PluginsListBox,
                                           Path=SelectedItem}"
                                       SettingsCommand="{Binding RelativeSource={RelativeSource Mode=FindAncestor,
                                                AncestorType={x:Type local:PluginsView}},
                                                Path=DataContext.OpenPluginSettingsCommand}"/>

            </Grid>
            
        </Border>
        
    </Grid>
    
</UserControl>
