<Window x:Class="VoiceAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceAssistant"
        mc:Ignorable="d"
        
        xmlns:controls="clr-namespace:Synergy.WPF.Common.Controls;assembly=Synergy.WPF.Common"
        xmlns:components="clr-namespace:Synergy.WPF.Navigation.Components;assembly=Synergy.WPF.Navigation"
        xmlns:comps="clr-namespace:VoiceAssistant.Components"
        
        WindowStyle="None"
        AllowsTransparency="True"
        
        Background="{StaticResource Brushes.Background}"
        
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Styles/NavPanelStyle.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="MainGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="0.73*"/>
            <ColumnDefinition Width="0.27*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="0.2*"/>
        </Grid.RowDefinitions>
        
        <comps:WindowUpperPanel
            Grid.ColumnSpan="3"
            Panel.ZIndex="10"
            Margin="100 0 0 0"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"/>

        <AdornerDecorator x:Name="AdornerDecorator"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Grid.RowSpan="4"/>

        <controls:Sidebar
            x:Name="NavBar"
            Grid.RowSpan="4"
            TitleIcon="{StaticResource Icons.Main}"
            TitleIconColor="{StaticResource Brushes.Triple}"
            Style="{StaticResource Styles.Sidebar}">

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenCommandsTabCommand}"
                Icon="{StaticResource Icons.Commands}"
                Content="Commands"/>

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenScriptEditorTabCommand}"
                Icon="{StaticResource Icons.Scripts}"
                Content="Script editor"/>

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenPluginsTabCommand}"
                Icon="{StaticResource Icons.Plugin}"
                Content="Plugins"/>

            <controls:NavItem
                Style="{StaticResource Styles.NavItem}"
                NavCommand="{Binding OpenSettingsTabCommand}"
                Icon="{StaticResource Icons.Settings}"
                Content="Settings"/>

        </controls:Sidebar>
        
    </Grid>
    
</Window>
